# Copy to .env (never commit .env)

# Meta Model API key — https://dev.meta.ai
MODEL_API_KEY=

# Which model turns words into Steps.
MUSE_MODEL=muse-spark-1.3
# Reasoning effort sent to the model (low | medium | high), or "none" to omit.
MUSE_REASONING_EFFORT=low

# Access codes that unlock the AI features, as CODE:dailyLimit pairs.
# Example: ACCESS_CODES=JUDGES-2026:300,ME-SECRET:2000,TESTERS-1:40
ACCESS_CODES=

# AI tidies shared by all visitors without a code (total, not per day). 0 turns them off.
FREE_TRIES=300

# Hard stop for total AI spend, in USD (enforced on the server).
SPEND_CAP_USD=100
# Muse Spark price per million tokens (used for the spend counter).
PRICE_INPUT_PER_M=1.25
PRICE_OUTPUT_PER_M=4.25

# Optional: Upstash Redis REST credentials so limits survive across serverless instances.
# Without these, limits are kept in memory (fine for local dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
